{
    "colors": {
        "editor.background": "$bg",
        "editor.foreground": "$fg",
        "editor.lineHighlightBackground": "$card",
        "editor.selectionBackground": "$surface",
        "editorCursor.foreground": "$accent",
        "editorLineNumber.foreground": "$muted",
        "editorLineNumber.activeForeground": "$fg",
        "editorGroupHeader.tabsBackground": "$bg_alt",
        "editorWidget.background": "$card",
        "tab.activeBackground": "$bg",
        "tab.inactiveBackground": "$bg_alt",
        "tab.activeBorderTop": "$accent",
        "tab.border": "$bg_alt",
        "titleBar.activeBackground": "$bg_alt",
        "titleBar.inactiveBackground": "$bg_alt",
        "activityBar.background": "$bg_alt",
        "activityBar.foreground": "$fg",
        "activityBar.inactiveForeground": "$muted",
        "activityBarBadge.background": "$accent",
        "activityBarBadge.foreground": "$on_accent",
        "sideBar.background": "$bg_alt",
        "sideBar.foreground": "$fg",
        "sideBarSectionHeader.background": "$bg_alt",
        "list.activeSelectionBackground": "$surface",
        "list.inactiveSelectionBackground": "$card",
        "list.hoverBackground": "$card_hover",
        "statusBar.background": "$bg_alt",
        "statusBar.foreground": "$fg",
        "statusBar.noFolderBackground": "$bg_alt",
        "panel.background": "$bg",
        "panel.border": "$surface",
        "terminal.background": "$bg",
        "terminal.foreground": "$fg",
        "terminal.ansiBlack": "$ansi0",
        "terminal.ansiRed": "$ansi1",
        "terminal.ansiGreen": "$ansi2",
        "terminal.ansiYellow": "$ansi3",
        "terminal.ansiBlue": "$ansi4",
        "terminal.ansiMagenta": "$ansi5",
        "terminal.ansiCyan": "$ansi6",
        "terminal.ansiWhite": "$ansi7",
        "terminal.ansiBrightBlack": "$ansi8",
        "terminal.ansiBrightRed": "$ansi9",
        "terminal.ansiBrightGreen": "$ansi10",
        "terminal.ansiBrightYellow": "$ansi11",
        "terminal.ansiBrightBlue": "$ansi12",
        "terminal.ansiBrightMagenta": "$ansi13",
        "terminal.ansiBrightCyan": "$ansi14",
        "terminal.ansiBrightWhite": "$ansi15",
        "focusBorder": "$accent",
        "button.background": "$accent",
        "button.foreground": "$on_accent",
        "button.hoverBackground": "$accent_hover",
        "badge.background": "$accent",
        "badge.foreground": "$on_accent",
        "progressBar.background": "$accent",
        "textLink.foreground": "$accent",
        "input.background": "$card",
        "dropdown.background": "$card",
        "quickInput.background": "$card"
    },
    "tokens": [
        {"name": "paletti: comments", "scope": ["comment", "punctuation.definition.comment"],
         "settings": {"foreground": "$muted", "fontStyle": "italic"}},
        {"name": "paletti: keywords", "scope": ["keyword", "storage", "storage.type", "keyword.control"],
         "settings": {"foreground": "$accent", "fontStyle": ""}},
        {"name": "paletti: operators", "scope": ["keyword.operator", "punctuation"],
         "settings": {"foreground": "$fg"}},
        {"name": "paletti: strings", "scope": ["string", "punctuation.definition.string"],
         "settings": {"foreground": "$ansi2"}},
        {"name": "paletti: escapes and regexps", "scope": ["constant.character.escape", "string.regexp"],
         "settings": {"foreground": "$ansi6"}},
        {"name": "paletti: numbers and constants", "scope": ["constant.numeric", "constant.language", "constant.other"],
         "settings": {"foreground": "$ansi3"}},
        {"name": "paletti: functions", "scope": ["entity.name.function", "support.function", "meta.function-call"],
         "settings": {"foreground": "$accent2"}},
        {"name": "paletti: types", "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class", "storage.type.class"],
         "settings": {"foreground": "$heading"}},
        {"name": "paletti: variables", "scope": ["variable", "variable.other"],
         "settings": {"foreground": "$fg"}},
        {"name": "paletti: parameters", "scope": ["variable.parameter"],
         "settings": {"foreground": "$ansi5", "fontStyle": "italic"}},
        {"name": "paletti: properties", "scope": ["variable.other.property", "support.type.property-name", "meta.object-literal.key"],
         "settings": {"foreground": "$ansi6"}},
        {"name": "paletti: tags", "scope": ["entity.name.tag"],
         "settings": {"foreground": "$accent"}},
        {"name": "paletti: attributes", "scope": ["entity.other.attribute-name"],
         "settings": {"foreground": "$ansi3"}},
        {"name": "paletti: markup headings", "scope": ["markup.heading", "entity.name.section"],
         "settings": {"foreground": "$heading", "fontStyle": "bold"}}
    ],
    "semantic": {
        "comment": {"foreground": "$muted", "italic": true},
        "keyword": "$accent",
        "string": "$ansi2",
        "number": "$ansi3",
        "regexp": "$ansi6",
        "function": "$accent2",
        "method": "$accent2",
        "macro": "$accent2",
        "decorator": "$accent2",
        "type": "$heading",
        "class": "$heading",
        "interface": "$heading",
        "enum": "$heading",
        "struct": "$heading",
        "namespace": "$heading",
        "typeParameter": "$heading",
        "variable": "$fg",
        "parameter": {"foreground": "$ansi5", "italic": true},
        "property": "$ansi6",
        "enumMember": "$ansi3"
    }
}
